{
  "name": "sanjay",
  "main": "http://localhost:3000",
  "node-remote": "http://localhost:3000",
  "node-main": "./src/desktop/server.js",
  "chromium-args": "--enable-logging=stderr",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "type": "tsc --noEmit",
    "doc": "node ./config/doc.js",
    "icon": "node ./config/icon.js",
    "dev": "concurrently -k npm:dev:website npm:dev:css npm:dev:server npm:dev:desktop",
    "dev:website": "wait-on ./cache/styles.css && esbuild main=./src/website/main.tsx styles=./cache/styles.css --bundle --outdir=./src/desktop --watch --servedir=./src/desktop --serve=3000",
    "dev:css": "tailwindcss -i ./src/website/styles.css -o ./cache/styles.css --watch",
    "dev:server": "esbuild ./src/server/desktop.ts --bundle --platform=node --format=cjs --outfile=./src/desktop/server.js --watch",
    "dev:desktop": "wait-on -c ./config/wait.json http-get://localhost:3000 && ./config/dev.js",
    "bld": "npm run bld:website && npm run bld:server && npm run bld:desktop",
    "bld:website": "cp ./src/website/index.html ./src/desktop/index.html && esbuild ./src/website/main.tsx --bundle --outdir=./src/desktop && tailwindcss -i ./src/website/styles.css -o ./src/desktop/styles.css --minify",
    "bld:desktop": "node ./config/bld.js",
    "bld:server": "esbuild ./src/server/desktop.ts --bundle --platform=node --format=cjs --outfile=./src/desktop/server.js",
    "pkg:desktop": "node ./config/pkg.js",
    "e2e": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**/*\" \"tests/specs/*.test.js\"",
    "server": "node src/server/server.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nwutils/doctor": "^0.1.3",
    "@nwutils/getter": "^0.3.1",
    "@nwutils/runner": "^0.2.7",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nw.js": "^0.115.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "nw-builder": "^4.24.0",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "26.7.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "warn"
    }
  }
}
